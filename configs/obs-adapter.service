[Unit]
Description=OBS API adapter backed by MinIO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obs-adapter
Group=obs-adapter
# Keep credentials out of the unit file: 600, owned by the service user.
EnvironmentFile=/etc/obs-adapter/minio.env
Environment=OBS_ADAPTER_LISTEN=:443
Environment=OBS_ADAPTER_DOMAIN=obs.internal
Environment=OBS_ADAPTER_TLS_CERT=/etc/obs-adapter/tls/server.crt
Environment=OBS_ADAPTER_TLS_KEY=/etc/obs-adapter/tls/server.key
Environment=OBS_ADAPTER_LOG_LEVEL=info
ExecStart=/usr/local/bin/obs-adapter
Restart=always
RestartSec=2

# The adapter only needs to reach the MinIO endpoint and listen on its port.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/obs-adapter
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
