# Credentials for the upstream MinIO endpoint.
#
# Copy to ~/.config/obs-adapter/minio.env (chmod 600, outside the repo) and
# fill in the values there. The adapter reads them from the environment:
#
#   set -a; . ~/.config/obs-adapter/minio.env; set +a
#   ./bin/obs-adapter -domain obs.local
#
# Anything written here is only an example -- never commit real keys.

# S3 endpoint of the MinIO server, scheme included.
OBS_ADAPTER_MINIO_ENDPOINT=https://minio.example.com

# Access key. Prefer a dedicated user whose policy is limited to the buckets
# the OBS application uses, not the root account.
OBS_ADAPTER_MINIO_AK=
OBS_ADAPTER_MINIO_SK=

# Region used for SigV4 canonicalisation. MinIO defaults to us-east-1 and
# accepts any value that matches the server configuration.
OBS_ADAPTER_MINIO_REGION=us-east-1

# Credentials clients (the OBS SDK) must sign with. Leave empty to disable
# signature verification -- development only.
OBS_ADAPTER_AK=
OBS_ADAPTER_SK=

# Base domain for virtual hosted style addressing (bucket.domain). Must match
# the endpoint the Java application is configured with.
OBS_ADAPTER_DOMAIN=
